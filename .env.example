# ── Database (required) ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/postgres

# ── Session (required) ───────────────────────────────────────────────
SESSION_SECRET=change-this-to-a-long-random-string

# ── Server (optional) ────────────────────────────────────────────────
PORT=3000

# ── Legacy (no longer used for login) ───────────────────────────────
# The admin password now lives in the database (site_config.admin_password)
# and is changed from the Settings tab in /admin.html. It starts out as
# "SERVICE" and is auto-upgraded to a secure hash the first time you log in.
# This var is kept only for backwards compatibility and can be removed.
ADMIN_PASSWORD=SERVICE

# ── Image Uploads — Supabase Storage (required for drag & drop uploads) ──
# Find these in your Supabase project: Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional — bucket is created automatically on startup if it doesn't exist
SUPABASE_BUCKET=portfolio-uploads

# ── Spotify "Now Playing" Widget (required for the Spotify feature) ─────
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
# Must exactly match a Redirect URI registered on your Spotify app.
# Defaults to <your-host>/admin/spotify/callback if omitted.
SPOTIFY_REDIRECT_URI=http://localhost:3000/admin/spotify/callback
